# Hosting en Neubox (Apache): las rutas de Angular (/promociones, /return, /admin/...)
# no existen como archivos; cualquier ruta que no sea un archivo real regresa index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# index.html nunca se guarda en caché: así cada despliegue se ve de inmediato.
# Los .js y .css llevan hash en el nombre y sí se pueden guardar un año.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
